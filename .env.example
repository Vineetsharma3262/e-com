# Aiven PostgreSQL: paste the Service URI from the service overview page.
# DATABASE_URL=postgres://avnadmin:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?sslmode=require

# Signs the 15-minute JWT access token. Use a long random string in production.
# JWT_SECRET=

# Free OTP email from https://resend.com (100 emails/day on the free plan).
# After wearveltho.com is verified, use an address on that domain.
RESEND_API_KEY=
RESEND_FROM=Wearveltho <support@wearveltho.com>
